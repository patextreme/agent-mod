{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist"
  },
  "include": [
    "extensions/**/*.ts",
    ".pi/agentflow/agentflow.d.ts",
    ".pi/agentflow/review-pr.ts"
  ],
  "exclude": ["extensions/agentflow/examples/**"]
}
