diff --git a/test/component/startup-metadata-only.test.ts b/test/component/startup-metadata-only.test.ts
new file mode 100644
index 0000000..8069ceb
--- /dev/null
+++ b/test/component/startup-metadata-only.test.ts
@@ -0,0 +1,124 @@
+import test from 'node:test'
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { Readable, Writable } from 'node:stream'
+import { ClientSideConnection, ndJsonStream } from '@agentclientprotocol/sdk'
+import assert from 'node:assert/strict'
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { delimiter, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { PiAcpAgent } from '../../src/acp/agent.js'
+import { resetMcpConfigSupportCacheForTests } from '../../src/acp/mcp-config.js'
+import { FakeAgentSideConnection, asAgentConn } from '../helpers/fakes.js'
+
+const FAKE_PI = fileURLToPath(new URL('../helpers/fake-pi.mjs', import.meta.url))
+const MODEL_TEXT = '{"ok":true,"answer":42}'
+
+const transports = process.env.PI_ACP_TEST_DIST ? ['source', 'dist'] : ['source']
+for (const transport of transports) {
+  for (const quietStartup of [false, true]) {
+    test(
+      `immediate JSON prompt receives only model text; startup metadata survives (${transport}, quietStartup=${quietStartup})`,
+      { timeout: 10_000 },
+      async () => {
+        const prev = { ...process.env }
+        const dir = mkdtempSync(join(tmpdir(), 'pi-acp-startup-'))
+        const cwd = join(dir, 'project')
+        const bin = join(dir, 'bin')
+        const agentDir = join(dir, 'agent')
+        for (const path of [cwd, bin, agentDir]) mkdirSync(path)
+        writeFileSync(join(cwd, 'AGENTS.md'), '# Startup regression context\n')
+        writeFileSync(join(agentDir, 'settings.json'), JSON.stringify({ quietStartup }))
+        // buildUpdateNotice/buildStartupInfo probe PATH, not PI_ACP_PI_COMMAND.
+        // Both probes are local and deterministic; no registry or real Pi needed.
+        for (const name of ['pi', 'npm']) symlinkSync(FAKE_PI, join(bin, name))
+        Object.assign(process.env, {
+          PATH: bin + delimiter + (prev.PATH ?? ''),
+          HOME: dir,
+          PI_CODING_AGENT_DIR: agentDir,
+          PI_ACP_PI_COMMAND: FAKE_PI,
+          FAKE_PI_INSTALLED_VERSION: '0.99.1',
+          FAKE_PI_LATEST_VERSION: '0.100.0',
+          FAKE_PI_HELP_HAS_MCP_CONFIG: '0',
+          FAKE_PI_HELP_HAS_NATIVE_MCP: '0',
+          FAKE_PI_MODEL_TEXT: MODEL_TEXT
+        })
+        resetMcpConfigSupportCacheForTests()
+        const conn = new FakeAgentSideConnection()
+        const child =
+          transport === 'dist' ? spawn(process.execPath, [process.env.PI_ACP_TEST_DIST!], { stdio: 'pipe' }) : null
+        let stderr = ''
+        child?.stderr.on('data', data => {
+          stderr += String(data)
+        })
+        const agent = child
+          ? new ClientSideConnection(
+              () => ({
+                sessionUpdate: msg => conn.sessionUpdate(msg),
+                requestPermission: params => conn.requestPermission(params)
+              }),
+              ndJsonStream(
+                Writable.toWeb(child.stdin) as WritableStream<Uint8Array>,
+                Readable.toWeb(child.stdout) as ReadableStream<Uint8Array>
+              )
+            )
+          : new PiAcpAgent(asAgentConn(conn), {} as any)
+        try {
+          await agent.initialize({ protocolVersion: 1, clientCapabilities: {} })
+          const response = await agent.newSession({
+            cwd,
+            mcpServers: [
+              { name: 'ptah', command: '/unused/ptah', args: [], env: [] },
+              { type: 'http', name: 'remote', url: 'https://example.invalid/mcp', headers: [] }
+            ]
+          })
+          const metadata = response._meta as { piAcp?: { startupInfo?: string | null } } | undefined
+          const startupInfo = metadata?.piAcp?.startupInfo
+          assert.equal(typeof startupInfo, 'string')
+          assert.match(startupInfo as string, /New version available: v0\.100\.0/)
+          assert.match(startupInfo as string, /dropped 1 MCP server\(s\) \(ptah\)/)
+          assert.match(startupInfo as string, /dropped 1 non-stdio MCP server\(s\) \(remote\)/)
+          if (quietStartup) assert.doesNotMatch(startupInfo as string, /## Context/)
+          else {
+            assert.match(startupInfo as string, /pi v0\.99\.1/)
+            assert.match(startupInfo as string, /## Context/)
+            assert.ok((startupInfo as string).includes(join(cwd, 'AGENTS.md')))
+          }
+          assert.equal(
+            conn.updates.some(u => u.update.sessionUpdate === 'agent_message_chunk'),
+            false
+          )
+          // Do not yield/drain startup timers before the first prompt.
+          const result = await agent.prompt({
+            sessionId: response.sessionId,
+            prompt: [{ type: 'text', text: 'Return only a JSON object.' }]
+          })
+          assert.equal(result.stopReason, 'end_turn')
+          await new Promise(resolve => setTimeout(resolve, 30))
+          const text = conn.updates
+            .flatMap(u =>
+              u.update.sessionUpdate === 'agent_message_chunk' && u.update.content.type === 'text'
+                ? [u.update.content.text]
+                : []
+            )
+            .join('')
+          assert.equal(text, MODEL_TEXT)
+          assert.deepEqual(JSON.parse(text), { ok: true, answer: 42 })
+          assert.equal(metadata?.piAcp?.startupInfo, startupInfo)
+        } finally {
+          if (child) {
+            const exited = once(child, 'exit')
+            child.kill('SIGTERM')
+            const [code] = await exited
+            assert.equal(code, 0, stderr)
+          } else (agent as PiAcpAgent).dispose()
+          for (const key of Object.keys(process.env)) if (!(key in prev)) delete process.env[key]
+          Object.assign(process.env, prev)
+          resetMcpConfigSupportCacheForTests()
+          rmSync(dir, { recursive: true, force: true })
+        }
+      }
+    )
+  }
+}
