+async function waitForStartup(conn: FakeAgentSideConnection): Promise<void> {
+  // newSession schedules context usage and command discovery after returning.
+  // Wait for their final notification rather than racing them with a fixed sleep.
+  const deadline = Date.now() + 5_000
+  while (!conn.updates.some(msg => msg.update.sessionUpdate === 'available_commands_update')) {
+    assert.ok(Date.now() < deadline, 'startup command discovery did not finish')
+    await new Promise(resolve => setTimeout(resolve, 10))
+  }
+}
